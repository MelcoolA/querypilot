# LLM provider: ollama (local, free) or anthropic (Claude API)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Context window in tokens. Ollama's 4096 default silently truncates long prompts.
OLLAMA_NUM_CTX=16384
# How long the model stays in memory after the last question (Ollama's default is 5m).
OLLAMA_KEEP_ALIVE=30m
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# How hard Claude thinks before answering: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# LangSmith tracing (optional). Sends prompts, SQL, and sample rows to smith.langchain.com.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=querypilot

# Warehouse backend: duckdb (dev) or snowflake (Phase 4)
WAREHOUSE=duckdb
# Local dataset for DuckDB: tpch (make data) or olist (make data-olist)
DATASET=olist

# Snowflake (WAREHOUSE=snowflake). Run snowflake/setup.sql once to create these.
# Account identifier from Snowsight: profile menu > Account > "orgname-accountname".
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=QUERYPILOT_AGENT
SNOWFLAKE_PRIVATE_KEY_FILE=.secrets/snowflake_agent_key.p8
SNOWFLAKE_ROLE=QUERYPILOT_READER
SNOWFLAKE_WAREHOUSE=QUERYPILOT_WH
SNOWFLAKE_DATABASE=QUERYPILOT
SNOWFLAKE_SCHEMA=OLIST
# Loader service user (snowflake/loader_user.sql); used only by make data-snowflake.
SNOWFLAKE_LOADER_USER=QUERYPILOT_LOADER_SVC
SNOWFLAKE_LOADER_KEY_FILE=.secrets/snowflake_loader_key.p8
